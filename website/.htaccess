# ===========================================================================
# .htaccess — Salierpraxis (statisches HTML-Paket, Apache 2.4)
#
# Inhalt in dieser Reihenfolge:
#   1. HTTPS erzwingen
#   2. Domain-/www-Vereinheitlichung          (AUSKOMMENTIERT — siehe Hinweis)
#   3. 301-Weiterleitungen der alten Joomla-/PHP-URLs
#   4. Fehlerseite (404)
#   5. Komprimierung (Gzip/Deflate)
#   6. Browser-Caching für Bilder, CSS und JS
#   7. Sicherheits- und Standard-Header
#   8. Verzeichnis-Einstellungen
#
# WICHTIG: Nach dem Hochladen bitte alle Punkte einmal im Browser prüfen —
# ein falscher Redirect kann die komplette Seite unerreichbar machen. Bei
# Unsicherheit die betreffende Zeile mit "#" auskommentiert lassen.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. HTTPS erzwingen
#
# Leitet jeden http-Aufruf dauerhaft auf https um. Voraussetzung: Für die
# Domain ist ein gültiges SSL-Zertifikat installiert (bei den meisten
# Hostern per Let's Encrypt kostenlos). Ohne Zertifikat diesen Block
# auskommentiert lassen, sonst ist die Seite nicht erreichbar.
#
# Die zweite Bedingung greift bei Hostern, die SSL vor dem Webserver
# terminieren (Proxy/Loadbalancer) und den Status per Header weitergeben.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Uebergangsadresse des Hosters nicht umleiten -------------------------
  # Vor dem Domain-Umzug ist die Seite nur unter der Adresse
  # <domain>.<konto>.kasserver.com erreichbar. Ohne diese Ausnahme wuerde die
  # Umleitung darunter jeden Aufruf sofort wieder auf die ALTE Seite schicken,
  # und der Test vor dem Livegang waere unmoeglich.
  # Die Regel bleibt auch nach dem Livegang stehen: sie stoert nicht und
  # rettet den naechsten Test.
  RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
  RewriteRule ^ - [L]

  # --- Alte Joomla-Adressen der Vorgaengerseite (ausgelesen am 08.10.2026) ---
  # Die alte Seite lief unter index.php?option=...&Itemid=... . Jede Adresse
  # zeigt dauerhaft (301) auf ihr neues Gegenstueck, die Parameter fallen weg (QSD).
  # Zuerst die Behandler-Artikel (die haben Itemid 101 und wuerden sonst auf die
  # Startseite statt zum Team gehen), danach die Menuepunkte.
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=14(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/impressum.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=15(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/datenschutz.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=19(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/#team [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=20(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/#team [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=21(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/#team [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=125(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/#team [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} option=com_content [NC]
  RewriteCond %{QUERY_STRING} (^|[&;])id=126(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/#team [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=101(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/ [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=103(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=104(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/duesseldorf.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=105(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/kempen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=111(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/impressum.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=112(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/datenschutz.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=113(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=189(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/pinhole.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=190(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=191(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=192(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/vollnarkose.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=193(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/implantologie.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=194(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/zahnersatz.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=195(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/fuellungen.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=196(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/endodontie.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=197(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/parodontitis.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=198(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/kiefergelenkstherapie.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=199(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/prophylaxe.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=200(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/veneers.html [R=301,L,QSD,NE]
  RewriteCond %{QUERY_STRING} (^|[&;])Itemid=201(&|$) [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/leistungen/bleaching.html [R=301,L,QSD,NE]
  # Alles andere aus Joomla (index.php?option=...) auf die Startseite.
  RewriteCond %{QUERY_STRING} (^|[&;])option=com_ [NC]
  RewriteRule ^(index\.php)?$ https://www.salierpraxis.de/ [R=301,L,QSD]

  # --- Immer https und immer www (eine einzige Adresse fuer Google) ---
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.salierpraxis.de/$1 [R=301,L]
</IfModule>


# ---------------------------------------------------------------------------
# 2. Domain-/www-Vereinheitlichung
#
# Stand Livegang 08.10.2026: salierpraxis.de ist die Hauptdomain, https und www
# werden oben in Abschnitt 1 erzwungen. Offen ist nur noch die Zweitdomain
# salierpraxis-duesseldorf.de: sie liegt bei einem anderen Anbieter und zeigt
# noch nicht auf diesen Webspace. Erst wenn sie hier eingerichtet ist, Block 2a
# einkommentieren.
#
# Ausgangslage: salierpraxis.de und salierpraxis-duesseldorf.de führen bisher
# teils unterschiedliche Inhalte. Empfehlung: salierpraxis.de als einzige
# Hauptdomain festlegen (standortübergreifend) und die zweite Domain
# vollständig per 301 weiterleiten. Die Canonical-Tags und die sitemap.xml
# dieses Pakets zeigen bereits auf  https://www.salierpraxis.de  (mit www).
#
# Vor dem Aktivieren sicherstellen, dass
#   a) beide Domains auf diesen Webspace zeigen,
#   b) für die Zieldomain ein SSL-Zertifikat inklusive www-Variante vorliegt.
#
# Danach die folgenden beiden Blöcke einkommentieren (Raute entfernen).
# ---------------------------------------------------------------------------
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#
#  # 2a) Alte Zweitdomain komplett auf die Hauptdomain umleiten
#  RewriteCond %{HTTP_HOST} ^(www\.)?salierpraxis-duesseldorf\.de$ [NC]
#  RewriteRule ^(.*)$ https://www.salierpraxis.de/$1 [R=301,L]
#
#  # 2b) Aufrufe ohne www auf die www-Variante umleiten (eine kanonische Form)
#  RewriteCond %{HTTP_HOST} ^salierpraxis\.de$ [NC]
#  RewriteRule ^(.*)$ https://www.salierpraxis.de/$1 [R=301,L]
#</IfModule>


# ---------------------------------------------------------------------------
# 3. 301-Weiterleitungen der alten URLs
#
# Die alte Website lieferte .php-Adressen. Damit Verlinkungen von außen und
# die in Suchmaschinen gespeicherten Adressen weiterhin funktionieren (und die
# aufgebaute Sichtbarkeit erhalten bleibt), wird jede alte Adresse dauerhaft
# (301) auf ihr neues Gegenstück geleitet.
#
# Reihenfolge beachten: Apache nimmt die ERSTE passende Regel. Die
# Sammelregeln am Ende greifen daher nur, wenn oben nichts gepasst hat.
#
# [PRÜFEN] Die Liste basiert auf den bekannten alten Adressen. Vor bzw. kurz
# nach dem Livegang die tatsächlich aufgerufenen alten URLs in der Google
# Search Console ("Seiten" → "Nicht gefunden (404)") und in den Server-Logs
# gegenprüfen und hier ergänzen.
# ---------------------------------------------------------------------------

# --- Leistungsseiten --------------------------------------------------------
# Achtung: Die alte URL der Parodontitis-Seite enthielt einen Tippfehler
# ("paradontitis"). Beide Schreibweisen werden abgedeckt.
Redirect 301 /leistungen_paradontitis.php   /leistungen/parodontitis.html
Redirect 301 /leistungen_parodontitis.php   /leistungen/parodontitis.html

Redirect 301 /leistungen_prophylaxe.php            /leistungen/prophylaxe.html
Redirect 301 /leistungen_implantologie.php         /leistungen/implantologie.html
Redirect 301 /leistungen_zahnersatz.php            /leistungen/zahnersatz.html
Redirect 301 /leistungen_fuellungen.php            /leistungen/fuellungen.html
Redirect 301 /leistungen_endodontie.php            /leistungen/endodontie.html
Redirect 301 /leistungen_veneers.php               /leistungen/veneers.html
Redirect 301 /leistungen_bleaching.php             /leistungen/bleaching.html
Redirect 301 /leistungen_lachgassedierung.php      /leistungen.html
Redirect 301 /leistungen_vollnarkose.php           /leistungen/vollnarkose.html
Redirect 301 /leistungen_pinhole.php               /leistungen/pinhole.html
Redirect 301 /leistungen_kiefergelenkstherapie.php /leistungen/kiefergelenkstherapie.html

# Häufige Kurz- und Alternativschreibweisen der alten Seiten
# (Lachgas wird seit Oktober 2026 nicht mehr angeboten, alte Adressen führen zur Leistungsübersicht)
Redirect 301 /leistungen_lachgas.php        /leistungen.html
Redirect 301 /leistungen_kiefergelenk.php   /leistungen/kiefergelenkstherapie.html
Redirect 301 /leistungen_wurzelbehandlung.php /leistungen/endodontie.html
Redirect 301 /leistungen_zahnreinigung.php  /leistungen/prophylaxe.html

# --- Nicht mehr angebotene Behandlungen ------------------------------------
# Diese Seiten haben keine Entsprechung mehr. Sie gehen bewusst auf die
# Leistungsübersicht (thematisch nächstliegende Seite), nicht auf die
# Startseite — das ist für Besucher und Suchmaschinen nachvollziehbarer.
Redirect 301 /leistungen_inman.php  /leistungen.html
<IfModule mod_alias.c>
  RedirectMatch 301 (?i)^/.*(inman|beautiful[-_]?smile).*$  /leistungen.html
</IfModule>

# --- Übrige Seiten ----------------------------------------------------------
Redirect 301 /duesseldorf.php  /duesseldorf.html
Redirect 301 /kempen.php       /kempen.html
Redirect 301 /kontakt.php      /kontakt.html
Redirect 301 /notdienst.php    /notdienst.html
Redirect 301 /impressum.php    /impressum.html
Redirect 301 /datenschutz.php  /datenschutz.html
Redirect 301 /leistungen.php   /leistungen.html
Redirect 301 /index.php        /
Redirect 301 /home.php         /
Redirect 301 /startseite.php   /

# --- Sammelregel für alle übrigen alten Leistungs-URLs ---------------------
# Fängt Adressen wie /leistungen_<irgendwas>.php ab, die oben nicht einzeln
# genannt sind, und leitet sie auf die Leistungsübersicht.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/leistungen_[a-z0-9_-]+\.php$  /leistungen.html
</IfModule>

# --- Joomla-Altlasten: siehe Abschnitt 1 (genaue Zuordnung je Menuepunkt) ---


# ---------------------------------------------------------------------------
# 4. Fehlerseite
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html


# ---------------------------------------------------------------------------
# 5. Komprimierung (Gzip/Deflate)
#
# Textdateien werden komprimiert ausgeliefert — spürbar schnellere Ladezeit,
# was auch in die Bewertung durch Suchmaschinen einfließt. Bilder (JPG) sind
# bereits komprimiert und werden ausgenommen.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ---------------------------------------------------------------------------
# 6. Browser-Caching
#
# Bilder, CSS und JavaScript werden im Browser zwischengespeichert; HTML nur
# kurz, damit inhaltliche Änderungen zeitnah ankommen.
#
# Hinweis für spätere Änderungen: Wird eine CSS- oder JS-Datei ersetzt, ohne
# den Dateinamen zu ändern, sehen wiederkehrende Besucher unter Umständen für
# die Cache-Dauer noch die alte Version. Dann entweder den Dateinamen
# anpassen (z. B. style.v2.css) oder die Laufzeit hier vorübergehend senken.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 week"

  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript         "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 day"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/ld+json     "access plus 1 hour"
  ExpiresByType text/plain              "access plus 1 day"
  ExpiresByType application/xml         "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Bilder, Schriften, CSS und JS: lange gültig
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Textdateien: kurz gültig (HTML siehe ganz unten: nie zwischenspeichern)
  <FilesMatch "\.(txt|xml|json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>


# ---------------------------------------------------------------------------
# 7. Sicherheits- und Standard-Header
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Verhindert, dass Browser den Dateityp abweichend vom Content-Type raten
  Header set X-Content-Type-Options "nosniff"

  # Einbetten der Seite in fremde Frames verhindern (Clickjacking-Schutz)
  Header set X-Frame-Options "SAMEORIGIN"

  # Sparsame Referrer-Weitergabe an externe Ziele
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Keine Berechtigungen anfordern, die diese Seite nicht benötigt
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS — erst aktivieren, wenn HTTPS dauerhaft und fehlerfrei läuft:
  # Ein Browser, der diesen Header einmal gesehen hat, ruft die Domain für
  # die angegebene Dauer ausschließlich per HTTPS auf.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Zeichensatz und Content-Type für die Textdateien im Wurzelverzeichnis
AddDefaultCharset UTF-8
<Files "llms.txt">
  ForceType text/plain
</Files>


# ---------------------------------------------------------------------------
# 8. Verzeichnis-Einstellungen
# ---------------------------------------------------------------------------
# Verzeichnislisten abschalten (niemand soll /bilder/ durchblättern können)
Options -Indexes

# Startdatei
DirectoryIndex index.html

# Zugriff auf diese Datei selbst sperren
<Files ".htaccess">
  Require all denied
</Files>

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
